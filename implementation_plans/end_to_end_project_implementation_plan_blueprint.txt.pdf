### Step 8: Master E2E Pytest Runner (`tests/test_invest_flow.py`)
Create `<app_name>_test/tests/test_invest_flow.py`:

```python
import pytest
from playwright.sync_api import Page
from data.test_data import TestData
from utils.data_generator import generate_random_mobile, generate_random_email
from pages.browse_fund_page import BrowseFundPage
from pages.validate_pan_page import ValidatePanPage
from pages.folio_details_page import FolioDetailsPage
from pages.identify_yourself_page import IdentifyYourselfPage
from pages.investor_details_page import InvestorDetailsPage

def test_flexi_fund_investment_flow(page: Page):
    # 1. Initialize Pages
    browse_fund = BrowseFundPage(page)
    validate_pan = ValidatePanPage(page)
    folio_details = FolioDetailsPage(page)
    identify_yourself = IdentifyYourselfPage(page)
    investor_details = InvestorDetailsPage(page)

    # 2. Dynamic inputs
    mobile = generate_random_mobile()
    email = generate_random_email()

    # 3. Execute Step-by-Step Flow
    browse_fund.navigate_to_browse_funds(TestData.URL)
    browse_fund.click_invest_now()

    validate_pan.enter_pan(TestData.PAN)
    folio_details.click_create_new_folio()

    identify_yourself.enter_name(TestData.NAME)
    identify_yourself.select_dob(TestData.DOB_DAY, TestData.DOB_MONTH, TestData.DOB_YEAR)
    identify_yourself.select_tax_status(TestData.TAX_STATUS_CODE)
    identify_yourself.select_mode_of_holding(TestData.MODE_OF_HOLDING_CODE)
    identify_yourself.enter_mobile(mobile)
    identify_yourself.enter_email(email)
    identify_yourself.click_generate_otp()
    identify_yourself.enter_otp(TestData.OTP_CODE)
    identify_yourself.click_proceed()

    # Continue subsequent steps...
```

