### Step 6: Dynamic Data Generator (`utils/data_generator.py`)
Create `<app_name>_test/utils/data_generator.py`:

```python
import random
import string

def generate_random_mobile() -> str:
    """Generates a random 10-digit Indian mobile number."""
    prefix = random.choice(['9', '8', '7', '6'])
    suffix = ''.join(random.choices(string.digits, k=9))
    return f"{prefix}{suffix}"

def generate_random_email() -> str:
    """Generates a random valid email address."""
    random_str = ''.join(random.choices(string.ascii_lowercase + string.digits, k=8))
    return f"uat_test_{random_str}@example.com"
```

---

### Step 7: Page Objects Implementation (`pages/*.py`)
Follow the POM pattern. Example for `pages/browse_fund_page.py`:

```python
from pages.base_page import BasePage
from data.urls import AppURLs

class BrowseFundPage(BasePage):
    def __init__(self, page):
        super().__init__(page)
        # Use dynamic URLs and visible=true
        self.invest_now_flexi_fund = f"a[href='{AppURLs.FUND_SELECT_FLEXI_PATH}'] >> visible=true >> nth=0"

    def navigate_to_browse_funds(self, url: str):
        self.go_to(url)

    def click_invest_now(self):
        self.wait_for_selector(self.invest_now_flexi_fund)
        self.js_click(self.invest_now_flexi_fund, "click_invest_now")
        self.page.wait_for_load_state("networkidle")
        self.wait(1000)
```

